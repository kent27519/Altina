local active = false

start.MouseButton1Click:Connect(function()
	active = not active

	if active then
		start.Text = "AUTO COLLECT: ON ✓"
		start.BackgroundColor3 = Color3.fromRGB(0, 150, 100)

		remote:FireServer("StartAutoCollect", selected)
	else
		start.Text = "AUTO COLLECT: OFF"
		start.BackgroundColor3 = Color3.fromRGB(20, 35, 45)

		remote:FireServer("StopAutoCollect")
	end
end)

